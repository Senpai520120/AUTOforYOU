# AUTOforYOU frontend — змінні для запуску БЕЗ Docker (задача 7.7a, 12-C9).
# Скопіюйте в frontend/.env.local (файл не коммітиться) і підставте свої значення.
# У Docker ці значення беруться з кореневого .env через docker-compose.yml (build args) - цей файл там не потрібен.
# Тест core/tests_env_templates.py перевіряє, що кожна process.env.* з frontend/ описана тут.

# --- Збирається в JS (NEXT_PUBLIC_*): після зміни потрібне перезбирання `npm run build` ----------
# Адреса API, яку бачить браузер (у dev - backend на :8000; у Docker - сайт через nginx).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Публічна адреса сайту (canonical, sitemap, Open Graph). На проді - https://ваш-домен.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Хости фото для next/image, через кому, лише https (домен сховища S3_CUSTOM_DOMAIN; конкретні CDN аукціонів).
# NEXT_PUBLIC_IMAGE_HOSTS=

# --- Читається на сервері Next (runtime) -----------------------------------------------------------
# Адреса backend для серверних запитів (SSR). Порожньо = NEXT_PUBLIC_API_URL. У Docker - http://backend:8000.
# INTERNAL_API_URL=
# Адреса, з якої SSR читає /media/ для OG-картинок. У Docker - nginx; змінювати не потрібно.
# INTERNAL_MEDIA_URL=http://nginx
# Потолок URL у sitemap.xml (протокол допускає 50000)
# SITEMAP_MAX_URLS=45000
# Кеш запитів сторінок моделей /prigon, секунди
# LANDING_REVALIDATE_SECONDS=60

# --- Playwright (e2e): лише для запуску тестів, НЕ для сайту -------------------------------------------
# Правила запуску - CLAUDE.md, розділ «E2E (Playwright)»: тестовий стек, сайт на http://localhost (nginx).
# E2E_BASE_URL=http://localhost
# Адреса API для запитів тестів напряму (за замовчуванням з E2E_BASE_URL)
# E2E_API_URL=http://localhost
# Пароль тестових користувачів (збігається з E2E_PASSWORD у .env e2e-стека)
# E2E_PASSWORD=
# 1 - дозволити віддалений стенд (запускається лише проект smoke)
# E2E_ALLOW_REMOTE=
# 1 - прогнати сценарій @sso (e2e/sso.spec.ts): потрібні Keycloak і docker-compose.sso.yml (задача SSO-1)
# E2E_SSO=
# 1 - TLS-стенд selfsigned (набір security-headers)
# E2E_TLS_STAND=
# 1 - backend зупинено навмисно (набір @backend-down)
# E2E_BACKEND_STOPPED=
# Адреса Mailpit для листів e2e (якщо піднятий)
# MAILPIT_URL=
