# ─────────────────────────────────────────────────────────────────────────────
# AUTOforYOU — шаблон окружения для e2e-стека (Playwright), задача 0.6b.
# Использование:  cp .env.e2e.example .env.e2e   (файл .env.e2e не коммитится)
# Запуск — см. docker-compose.e2e.yml. Реальные ключи сюда НЕ вписывать:
# стек тестовый, внешние провайдеры отключены (пустые значения).
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL (одноразовая БД e2e-стека, не боевая) ────────────────────────
POSTGRES_DB=autoforyou
POSTGRES_USER=autoforyou
POSTGRES_PASSWORD=e2e_local_db_pass
DATABASE_URL=postgres://autoforyou:e2e_local_db_pass@db:5432/autoforyou

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=e2e_local_redis_pass
REDIS_URL=redis://:e2e_local_redis_pass@redis:6379/0

# ─── Django ───────────────────────────────────────────────────────────────────
# Сгенерировать (не короче 50 символов, задача 7.2): python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=false
CORS_ALLOW_ALL_ORIGINS=false
# TLS в стеке нет (задача 7.1): nginx только :80, Django без SSL-редиректа и HSTS.
# Для проверки HTTPS: TLS_MODE=selfsigned (docker-compose.e2e.yml не меняется).
TLS_MODE=off
DOMAIN=localhost
# Стенд по HTTP: cookie access/refresh/csrftoken без флага Secure (задача 1.4).
AUTH_COOKIE_SECURE=false
# Весь набор Playwright идёт с одного IP: дефолтные 60/hour на гостя он выбирает
# к мобильным проектам (входы, регистрации, csrf). Только для e2e-стенда.
THROTTLE_ANON_RATE=100000/hour
THROTTLE_USER_RATE=100000/hour
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
SITE_URL=http://localhost

# ─── Frontend URLs (подстановка в docker-compose.yml через --env-file) ───────
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SITE_URL=http://localhost
NGINX_PORT=80
GUNICORN_WORKERS=2

# ─── E2E ──────────────────────────────────────────────────────────────────────
# Разрешает команду e2e_seed. ТОЛЬКО в тестовом стеке.
E2E_SEED_ALLOWED=true
# Заглушка: замените на любой тестовый пароль (Playwright берёт его из
# переменной окружения E2E_PASSWORD с тем же значением).
E2E_PASSWORD=change-me-e2e-password

# ─── Внешние провайдеры: ПУСТО (в e2e не нужны и не должны быть боевыми) ─────
LIQPAY_SANDBOX=true
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_B2B_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BROKER_CHAT_ID=
LEAD_JOURNAL_CHAT_ID=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@e2e.test
# e2e: курс - демо (без запитів до НБУ). Пошта НЕ в demo: листи йдуть SMTP-ом у Mailpit
# (docker-compose.e2e.yml задає EMAIL_BACKEND/EMAIL_HOST), e2e читають їх через API Mailpit.
NBU_MODE=demo
OPENDATABOT_API_KEY=
APIFY_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Защита входа (задача 1.5): малые пороги для login-limit.spec.ts
NUM_PROXIES=1
THROTTLE_LOGIN_RATE=2000/hour
THROTTLE_UPLOADS_RATE=2000/hour
THROTTLE_REGISTER_RATE=2000/hour
THROTTLE_REFRESH_RATE=2000/hour
THROTTLE_LEAD_RATE=2000/hour
THROTTLE_CALCULATOR_RATE=2000/hour
THROTTLE_LEAD_EXPORT_RATE=2000/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=1
THROTTLE_PASSWORD_RESET_RATE=2000/hour
THROTTLE_DATA_EXPORT_RATE=2000/hour
# Приватные фото трекинга через nginx (задача 1.10), как на проде
PRIVATE_MEDIA_USE_X_ACCEL=true

# ─── Модули (задача 2.8) ──────────────────────────────────────────────────────
# e2e-стек работает с замороженными модулями, как прод.
LOTS_ENABLED=false
VIN_REPORTS_ENABLED=false
CARVERTICAL_PARTNER_URL=
B2B_ENABLED=false
DEALERS_ENABLED=false
SHIPMENTS_ENABLED=false
LEGACY_CARS_API_ENABLED=false

# ─── Розділ «Оголошення по Україні» і платежі (задача 6.7) ─────────────────────
# e2e-стек працює в режимі ВОЛНИ-2 (все відкрито): на ньому спираються спеки подачі
# оголошень, переписки, угод, обраного, збережених пошуків і просування.
# frontend/e2e/c2c-flag.spec.ts читає режим із GET /api/v1/site-settings/ і сам
# пропускає блоки інших режимів. Режими «вимкнено»/«засів» покриті Django-тестами
# (core/tests_c2c_flag.py, local_listings/tests_posting.py); щоб прогнати їх у браузері,
# підніміть окремий стек зі значеннями: off = C2C_ENABLED=false;
# засів = C2C_ENABLED=true + C2C_PUBLIC_POSTING_ENABLED=false.
C2C_ENABLED=true
C2C_PUBLIC_POSTING_ENABLED=true
PAYMENTS_ENABLED=true

# ─── Вхід через SSO (задача SSO-1) ─────────────────────────────────────────────
# Вимкнено: e2e-стек не залежить від Keycloak. Для сценарію @sso (frontend/e2e/sso.spec.ts)
# додайте -f docker-compose.sso.yml (він вмикає OIDC_* сам; тоді e2e_seed створить ad_alice)
# і задайте тут OIDC_CLIENT_SECRET; прогін з E2E_SSO=1 (див. README).
OIDC_ENABLED=false
# OIDC_CLIENT_SECRET=
