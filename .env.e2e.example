# ─────────────────────────────────────────────────────────────────────────────
# AUTOforYOU — шаблон окружения для e2e-стека (Playwright), задача 0.6b.
# Использование:  cp .env.e2e.example .env.e2e   (файл .env.e2e не коммитится)
# Запуск — см. docker-compose.e2e.yml. Реальные ключи сюда НЕ вписывать:
# стек тестовый, внешние провайдеры отключены (пустые значения).
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL (одноразовая БД e2e-стека, не боевая) ────────────────────────
POSTGRES_DB=autoforyou
POSTGRES_USER=autoforyou
POSTGRES_PASSWORD=e2e_local_db_pass
DATABASE_URL=postgres://autoforyou:e2e_local_db_pass@db:5432/autoforyou

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=e2e-only-secret-key-not-for-production
DEBUG=false
CORS_ALLOW_ALL_ORIGINS=false
# TLS в стеке нет: без этого Django редиректил бы весь HTTP на HTTPS.
SECURE_SSL_REDIRECT=false
# Стенд по HTTP: cookie access/refresh/csrftoken без флага Secure (задача 1.4).
AUTH_COOKIE_SECURE=false
# Весь набор Playwright идёт с одного IP: дефолтные 60/hour на гостя он выбирает
# к мобильным проектам (входы, регистрации, csrf). Только для e2e-стенда.
THROTTLE_ANON_RATE=100000/hour
THROTTLE_USER_RATE=100000/hour
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
SITE_URL=http://localhost

# ─── Frontend URLs (подстановка в docker-compose.yml через --env-file) ───────
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SITE_URL=http://localhost
NGINX_PORT=80
GUNICORN_WORKERS=2

# ─── E2E ──────────────────────────────────────────────────────────────────────
# Разрешает команду e2e_seed. ТОЛЬКО в тестовом стеке.
E2E_SEED_ALLOWED=true
# Заглушка: замените на любой тестовый пароль (Playwright берёт его из
# переменной окружения E2E_PASSWORD с тем же значением).
E2E_PASSWORD=change-me-e2e-password

# ─── Внешние провайдеры: ПУСТО (в e2e не нужны и не должны быть боевыми) ─────
LIQPAY_SANDBOX=true
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_B2B_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BROKER_CHAT_ID=
LEAD_JOURNAL_CHAT_ID=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
OPENDATABOT_API_KEY=
APIFY_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Защита входа (задача 1.5): малые пороги для login-limit.spec.ts
NUM_PROXIES=1
THROTTLE_LOGIN_RATE=2000/hour
THROTTLE_REGISTER_RATE=2000/hour
THROTTLE_REFRESH_RATE=2000/hour
THROTTLE_LEAD_RATE=2000/hour
THROTTLE_LEAD_EXPORT_RATE=2000/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=1
