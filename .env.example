# AUTOforYOU — environment variables template (UTF-8, no BOM)
# Copy to .env, fill in real values. Never commit .env to git.
# -----------------------------------------------------------------------

# --- Compose project name (ВАЖНО!) ------------------------------------
# Фиксирует имя Docker volumes. Без этого при клоне в другую папку
# создадутся новые пустые volumes — тихая потеря данных!
COMPOSE_PROJECT_NAME=autoforyou

# --- Django core -------------------------------------------------------
# НА ПРОДІ — обов'язково! Генерація: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here
DEBUG=false
# Відкритий CORS. На проді завжди false — задавайте CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=false
# Вимикати лише якщо TLS-редирект робить балансувальник.
SECURE_SSL_REDIRECT=true
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
# Origin, з яких приймаються POST/PUT/PATCH/DELETE з cookie-сесією (CSRF).
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- JWT у httpOnly-cookie (задача 1.3) -----------------------------------
# Secure-cookie працюють лише через HTTPS. На проді — тільки true.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
# Порожньо = cookie лише для поточного хоста (сайт і API на одному домені).
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_ACCESS_NAME=access
AUTH_COOKIE_REFRESH_NAME=refresh
# Строк життя токенів.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Database (Docker-сервис db) ---------------------------------------
# db — внутреннее имя сервиса в docker-compose. НЕ localhost, НЕ host.docker.internal.
POSTGRES_DB=autoforyou
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-db-password
DATABASE_URL=postgresql://postgres:your-strong-db-password@db:5432/autoforyou

# --- Redis -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Frontend (build-time args, baked в JS) ---------------------------
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Nginx / Gunicorn --------------------------------------------------
NGINX_PORT=80
GUNICORN_WORKERS=3

# --- S3 media storage --------------------------------------------------
# S3_BUCKET_NAME=your-s3-bucket-name
# S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- LiqPay ------------------------------------------------------------
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key
LIQPAY_SANDBOX=true

# --- External APIs -----------------------------------------------------
OPENDATABOT_API_KEY=your_opendatabot_api_key
APIFY_TOKEN=your_apify_token

# --- Email -------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@autoforyou.ua

# --- Telegram bot (all optional) --------------------------------------
# TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_BOT_USERNAME=your_bot_name_bot
# TELEGRAM_CHANNEL_ID=@your_channel
# TELEGRAM_B2B_CHANNEL_ID=@your_b2b_channel
# TELEGRAM_WEBHOOK_SECRET=your_random_secret_string
# Запасной chat_id брокера/группы для заявок (основной - в админке, 'Налаштування сповіщень про заявки')
# TELEGRAM_BROKER_CHAT_ID=-1001234567890
# SITE_URL=https://your-domain.com

# --- C2C: місцеві оголошення ------------------------------------------
# LOCAL_LISTING_MAX_ACTIVE=10

# ─── E2E (Playwright) ─────────────────────────────────────────────────────────
# ТІЛЬКИ для тестового стека / CI. На проді НЕ задавати.
# E2E_SEED_ALLOWED=true
# E2E_PASSWORD=

# Защита входа от перебора (задача 1.5)
NUM_PROXIES=0
# THROTTLE_LOGIN_RATE=10/min
# THROTTLE_REGISTER_RATE=5/hour
# THROTTLE_REFRESH_RATE=30/min
# Заявка брокеру (задача 2.1b): лимит на IP или пользователя
# THROTTLE_LEAD_RATE=5/hour
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15

# Подтверждение email и антибот (задача 1.6)
# turnstile | honeypot | off (off - только DEBUG=True). Honeypot работает всегда.
CAPTCHA_PROVIDER=turnstile
# ТОЛЬКО dev: всегда пропускают; на проде заменить. Публичные ТЕСТОВЫЕ ключи Cloudflare (не секреты). На проде заменить
# ключами из Cloudflare Dashboard -> Turnstile -> Add site. Без секрета работает только honeypot.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Вход: капча после N неудачных попыток (счётчик задачи 1.5); CAPTCHA_ON_LOGIN=true - всегда.
# CAPTCHA_LOGIN_AFTER_FAILURES=3
# CAPTCHA_ON_LOGIN=false
# CAPTCHA_MIN_FILL_SECONDS=3
# Ограничения до подтверждения email: объявления, сообщения, заявка дилера.
# EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_VERIFY_TTL_HOURS=48
# THROTTLE_VERIFY_RESEND_RATE=3/hour
