# AUTOforYOU — environment variables template (UTF-8, no BOM)
# Copy to .env, fill in real values. Never commit .env to git.
# -----------------------------------------------------------------------

# --- Compose project name (ВАЖНО!) ------------------------------------
# Фиксирует имя Docker volumes. Без этого при клоне в другую папку
# создадутся новые пустые volumes — тихая потеря данных!
COMPOSE_PROJECT_NAME=autoforyou

# --- Django core -------------------------------------------------------
# НА ПРОДІ — обов'язково, не коротше 50 символів, без заглушок (задача 7.2). Генерація: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here
DEBUG=false
# Відкритий CORS. На проді завжди false — задавайте CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=false
# Явне значення важливіше за TLS_MODE; зазвичай не задається (див. блок HTTPS нижче).
# SECURE_SSL_REDIRECT=true
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
# Origin, з яких приймаються POST/PUT/PATCH/DELETE з cookie-сесією (CSRF).
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- JWT у httpOnly-cookie (задача 1.3) -----------------------------------
# Secure-cookie працюють лише через HTTPS. На проді — тільки true.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
# Порожньо = cookie лише для поточного хоста (сайт і API на одному домені).
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_ACCESS_NAME=access
AUTH_COOKIE_REFRESH_NAME=refresh
# Строк життя токенів.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Database (Docker-сервис db) ---------------------------------------
# db — внутреннее имя сервиса в docker-compose. НЕ localhost, НЕ host.docker.internal.
POSTGRES_DB=autoforyou
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-db-password
DATABASE_URL=postgresql://postgres:your-strong-db-password@db:5432/autoforyou

# --- Redis -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Frontend (build-time args, baked в JS) ---------------------------
NEXT_PUBLIC_API_URL=https://yourdomain.com
# Хости фото для next/image (через кому, лише https): домен сховища (S3_CUSTOM_DOMAIN).
# Якщо фото лотів не переносяться (LOT_PHOTO_ALLOWED_HOSTS порожній), сюди ж - конкретні CDN аукціонів.
# NEXT_PUBLIC_IMAGE_HOSTS=
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Потолок числа URL в sitemap.xml (протокол допускает 50000). По умолчанию 45000.
# SITEMAP_MAX_URLS=45000
# Кеш серверних запитів сторінок моделей /prigon, секунди (за замовчуванням 60). Читає Next (SSR) у runtime.
# LANDING_REVALIDATE_SECONDS=60
# Адреса, з якої Next (SSR) читає /media/ для фото в OG-картинках: nginx у docker-мережі. Змінювати не потрібно.
# INTERNAL_MEDIA_URL=http://nginx

# --- Nginx / Gunicorn --------------------------------------------------
NGINX_PORT=80
GUNICORN_WORKERS=3

# --- S3 media storage --------------------------------------------------
# S3_BUCKET_NAME=your-s3-bucket-name
# S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Публичный домен бакета (CDN): ссылки без подписи, тот же хост - в NEXT_PUBLIC_IMAGE_HOSTS
# S3_CUSTOM_DOMAIN=media.yourdomain.com
# Окремий bucket БЕЗ публічного домену для приватних фото трекінгу (обов'язково разом із S3_CUSTOM_DOMAIN)
# PRIVATE_S3_BUCKET_NAME=

# --- Логи (задача 7.2) ---------------------------------------------------
# LOG_LEVEL=INFO
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5
# LOG_RETENTION_DAYS=90
# Swagger/Redoc для всех (по умолчанию только admin-роль)
# API_DOCS_PUBLIC=false
# DEBUG=true с публичным хостом в ALLOWED_HOSTS - ошибка старта; обход только для отладки, НЕ на проде
# ALLOW_DEBUG_ON_PUBLIC_HOST=false
# Celery синхронно без воркера (раньше включалось от DEBUG)
# CELERY_EAGER=false

# --- Безопасная загрузка фото (задача 1.10) -----------------------------
# Тип определяется по содержимому, EXIF/GPS снимается, имя - uuid.
# Максимальный размер файла, МБ (общий; для C2C см. LOCAL_LISTING_PHOTO_MAX_SIZE_MB)
# UPLOAD_IMAGE_MAX_SIZE_MB=8
# Максимум пикселей (ширина x высота), защита от decompression bomb
# UPLOAD_IMAGE_MAX_PIXELS=25000000
# Разрешённые форматы, только из JPEG,PNG,WEBP
# UPLOAD_IMAGE_ALLOWED_FORMATS=JPEG,PNG,WEBP
# Качество пересохранения JPEG/WEBP (1-95)
# UPLOAD_IMAGE_JPEG_QUALITY=85
# Хосты CDN, откуда upload_lot_photos может качать фото лотов (через запятую,
# *.example.com - поддомены). Пусто - перенос фото лотов выключен. Только https.
# НЕ ставить общие домены облаков (*.amazonaws.com, *.cloudfront.net, *.googleusercontent.com):
# там любой может разместить файл - только конкретные CDN-хосты аукционов.
# LOT_PHOTO_ALLOWED_HOSTS=
# Приватные файлы (фото трекинга) - вне MEDIA_ROOT. В Docker: /app/private_media (том private_media)
# PRIVATE_MEDIA_ROOT=
# true - отдавать приватные файлы через nginx (X-Accel-Redirect, location /protected-media/).
# На проде за nginx из docker-compose - true; без nginx (runserver) - false.
# PRIVATE_MEDIA_USE_X_ACCEL=false
# Срок жизни подписанной ссылки S3 на фото трекинга, секунд
# PRIVATE_MEDIA_URL_EXPIRE=300

# --- LiqPay ------------------------------------------------------------
# Порожні ключі = «не налаштовано» (плейсхолдери на кшталт your_* теж вважаються не налаштованими).
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true
# Режим LiqPay: auto (ключі є -> sandbox/real за LIQPAY_SANDBOX, інакше «не налаштовано») | sandbox | real | off
LIQPAY_MODE=auto

# --- External APIs -----------------------------------------------------
OPENDATABOT_API_KEY=
APIFY_TOKEN=
# Режими провайдерів (задача 3.1): auto (за замовчуванням) | real | demo | off. demo - лише для dev/показу.
NBU_MODE=auto
# Адреса API НБУ (змінювати не потрібно) і через скільки днів курс вважається застарілим
# NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange
# EXCHANGE_RATE_MAX_AGE_DAYS=3
VIN_DECODE_MODE=auto
# VIN-звіт і Opendatabot заморожені (3.2a): off, поки VIN_REPORTS_ENABLED=false
VIN_REPORT_MODE=off
OPENDATABOT_MODE=off
LOTS_MODE=auto
# CARVERTICAL_API_KEY=
# Спільний таймаут HTTP-викликів провайдерів, секунди
# INTEGRATIONS_HTTP_TIMEOUT=10

# --- Email -------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your_email_password
# Адреса відправника на ВАШОМУ домені. Порожньо = пошта «не налаштовано» (дефолту-домену немає).
# DEFAULT_FROM_EMAIL=noreply@your-domain.example
# Таймаут SMTP, секунди (завислий сервер не блокує воркер)
# EMAIL_TIMEOUT=10
# Режим пошти: auto (SMTP-бекенд, EMAIL_HOST і DEFAULT_FROM_EMAIL задані -> real, інакше off) | real | demo | off
EMAIL_MODE=auto
# Скільки останніх демо-відправок (Outbox) зберігати
# DEMO_OUTBOX_KEEP=200

# --- Telegram bot (all optional) --------------------------------------
# TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_BOT_USERNAME=your_bot_name_bot
# TELEGRAM_CHANNEL_ID=@your_channel
# TELEGRAM_B2B_CHANNEL_ID=@your_b2b_channel
# TELEGRAM_WEBHOOK_SECRET=your_random_secret_string
# Как бот получает апдейты: polling (по умолчанию, без домена) или webhook (нужны HTTPS,
# SITE_URL=https://... и TELEGRAM_WEBHOOK_SECRET). Не путать с TELEGRAM_MODE ниже.
TELEGRAM_UPDATES_MODE=polling
# Режим Telegram: auto (токен є -> real, інакше off) | real | demo | off
TELEGRAM_MODE=auto
# Запасной chat_id брокера/группы для заявок (основной - в админке, 'Налаштування сповіщень про заявки')
# TELEGRAM_BROKER_CHAT_ID=-1001234567890
# Группа с партнёром: журнал заявок (2.15), без имени и телефона. Пусто - журнал выключен
# LEAD_JOURNAL_CHAT_ID=-1001234567890
# Запасной email брокера для заявок, если Telegram не настроен или не доставил (основной - в админке
# 'Налаштування сповіщень про заявки'). Письма идут через SMTP (EMAIL_HOST и т.д.)
# BROKER_NOTIFY_EMAIL=broker@your-domain.com
# Как часто досылать недоставленные заявки (минуты) и сколько попыток до предупреждения админам
# LEAD_NOTIFY_RETRY_MINUTES=10
# LEAD_NOTIFY_MAX_ATTEMPTS=5
# SITE_URL=https://your-domain.com

# --- C2C: місцеві оголошення ------------------------------------------
# LOCAL_LISTING_MAX_ACTIVE=10
# Максимальный размер фото объявления, МБ. Пусто - общий UPLOAD_IMAGE_MAX_SIZE_MB
# LOCAL_LISTING_PHOTO_MAX_SIZE_MB=

# ─── E2E (Playwright) ─────────────────────────────────────────────────────────
# ТІЛЬКИ для тестового стека / CI. На проді НЕ задавати.
# E2E_SEED_ALLOWED=true
# E2E_PASSWORD=

# Защита входа от перебора (задача 1.5)
NUM_PROXIES=0
# THROTTLE_LOGIN_RATE=10/min
# THROTTLE_REGISTER_RATE=5/hour
# THROTTLE_REFRESH_RATE=30/min
# Заявка брокеру (задача 2.1b): лимит на IP или пользователя
# Калькулятор (2.6): лимит расчётов на IP/пользователя и срок хранения анонимных расчётов (дней)
# THROTTLE_CALCULATOR_RATE=30/hour
# ANON_CALCULATION_TTL_DAYS=30
# THROTTLE_LEAD_RATE=5/hour
# CSV-экспорт заявок (задача 2.15)
# THROTTLE_LEAD_EXPORT_RATE=10/hour
# Загрузка фото объявлений, запросов на пользователя (задача 1.10)
# THROTTLE_UPLOADS_RATE=30/hour
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15

# Подтверждение email и антибот (задача 1.6)
# turnstile | honeypot | off (off - только DEBUG=True). Honeypot работает всегда.
CAPTCHA_PROVIDER=turnstile
# ТОЛЬКО dev: всегда пропускают; на проде заменить. Публичные ТЕСТОВЫЕ ключи Cloudflare (не секреты). На проде заменить
# ключами из Cloudflare Dashboard -> Turnstile -> Add site. Без секрета работает только honeypot.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Вход: капча после N неудачных попыток (счётчик задачи 1.5); CAPTCHA_ON_LOGIN=true - всегда.
# CAPTCHA_LOGIN_AFTER_FAILURES=3
# CAPTCHA_ON_LOGIN=false
# CAPTCHA_MIN_FILL_SECONDS=3
# Ограничения до подтверждения email: объявления, сообщения, заявка дилера.
# EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_VERIFY_TTL_HOURS=48
# THROTTLE_VERIFY_RESEND_RATE=3/hour
# Сброс пароля (1.7): срок ссылки в секундах и лимит запросов/подтверждений/смен пароля на IP или пользователя.
# PASSWORD_RESET_TIMEOUT=3600
# THROTTLE_PASSWORD_RESET_RATE=5/hour
# Выгрузка «Мої дані» (1.8): JSON со всеми данными пользователя, лимит на пользователя.
# THROTTLE_DATA_EXPORT_RATE=5/day

# --- Мониторинг ошибок (задача 7.6): sentry.io или GlitchTip, пусто - выключен ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# Отчёты об ошибках фронтенда на IP
# THROTTLE_CLIENT_ERRORS_RATE=20/hour
# Клиентские счётчики (8.7, POST /api/v1/metrics/event/) на IP
# THROTTLE_METRICS_EVENT_RATE=60/min
# THROTTLE_TELEGRAM_LINK_RATE=10/hour

# --- Celery: повторы и журнал упавших задач (задача 8.9) ---
# RESILIENT_TASK_MAX_RETRIES=3
# true: задача подтверждается после выполнения (при падении воркера не теряется, возможен повтор)
# RESILIENT_TASK_ACKS_LATE=true
# FAILED_TASK_RETENTION_DAYS=90
# FAILED_TASK_ARG_MAX_LEN=64

# --- Модули (задача 2.8): заморожены до разморозки задач 2.9, 2.10, 2.11, 3.3 ---
# Источник правды - только .env (в админке не редактируется); после смены нужен перезапуск backend.
# Держать false, как на проде. true любого флага при DEBUG=False - предупреждение launch_check.
LOTS_ENABLED=false
# Платні VIN-звіти (carVertical) і реєстри (Opendatabot): заморожені, тримати false
VIN_REPORTS_ENABLED=false
# Партнерське посилання carVertical (https://..., видає партнерська програма). Порожньо = посилання на сайті немає.
CARVERTICAL_PARTNER_URL=
B2B_ENABLED=false
DEALERS_ENABLED=false
SHIPMENTS_ENABLED=false
# Legacy cars (/api/calculate/, /api/list/), решение владельца Q7: оставить false
LEGACY_CARS_API_ENABLED=false

# --- Розділ «Оголошення по Україні» (C2C) і платежі (задача 6.7) ---
# Читається лише через core/c2c.py; після зміни перезапустити backend, celery worker і beat. Фронт перезбирати не треба.
# C2C_ENABLED: розділ видно. true — ЛИШЕ для dev; у проді значення з .env.docker.example (false).
# C2C_ENABLED: false = 404 на всіх C2C-маршрутах, фронт показує «Скоро».
C2C_ENABLED=true
# C2C_PUBLIC_POSTING_ENABLED: подача відкрита всім. false = «засів»: оголошення вносить staff через адмінку.
C2C_PUBLIC_POSTING_ENABLED=false
# PAYMENTS_ENABLED: створення оплат (просування, checkout). false = закрито. Callback LiqPay працює завжди (підпис обов'язкова).
PAYMENTS_ENABLED=false

# ─── HTTPS, HSTS, CSP (задача 7.1) ─────────────────────────────────────────────
# Домен сайту (без http/https). Для локальної розробки - localhost.
DOMAIN=localhost
# true = nginx приймає і www.DOMAIN (потрібні DNS-записи для обох імен).
DOMAIN_WWW=false
# Режим TLS: off (лише :80, розробка/CI), selfsigned (:443 із самопідписаним сертифікатом, тестовий стенд),
# letsencrypt (:443 + certbot; перший сертифікат: ./scripts/init-letsencrypt.sh), external (TLS знімає
# зовнішній балансувальник/Cloudflare; балансувальник ОБОВ'ЯЗКОВО ставить X-Forwarded-Proto).
# external БЕЗ Cloudflare вимагає TRUSTED_PROXY_IPS (нижче), інакше nginx не стартує.
# Порожній TLS_MODE у Django = колишня поведінка: SSL-редирект і HSTS увімкнені (для старих .env).
# Django і nginx беруть режим з цієї змінної. У режимах selfsigned/letsencrypt/external редирект робить nginx або
# балансувальник, Django не редиректить (SSR Next ходить у backend по http). Явний SECURE_SSL_REDIRECT важливіший.
# Порожній TLS_MODE у Django лишає колишню поведінку (редирект і HSTS), у nginx - off.
TLS_MODE=off
# Email для сповіщень Let's Encrypt про закінчення сертифіката; staging=true - пробний запуск без лімітів.
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
# HSTS віддається лише по https. preload майже незворотний: вмикати, лише коли ВСІ піддомени назавжди на https.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# true = політика CSP віддається як Content-Security-Policy-Report-Only (перший тиждень на проді).
CSP_REPORT_ONLY=false
# Додаткові джерела CSP: через пробіл, лише https://host[:port] (без * і без голого https:). Домени беріть з
# документації провайдерів: S3/R2, аналітика. Для CAPTCHA_PROVIDER=turnstile домен challenges.cloudflare.com
# додається в script-src і frame-src автоматично.
CSP_SCRIPT_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=
# ─── Веб-аналітика (задача 3.5) ───────────────────────────────────────────────
# ID публічні (не секрет); змінюються без перезбирання фронту, потрібен перезапуск backend і nginx.
# Порожньо або неправильний формат = вимкнено. Домени провайдера додаються в CSP автоматично лише за заданого ID.
# GA4: GA4 -> Admin -> Data Streams -> Web -> Measurement ID (G-XXXXXXXXXX). Вмикається ЛИШЕ після згоди «Прийняти всі».
GA4_MEASUREMENT_ID=
# Cloudflare Web Analytics: Cloudflare -> Web Analytics -> сайт -> token з фрагмента JS. Без cookies, згоди не потребує.
CLOUDFLARE_ANALYTICS_TOKEN=
# Ліміти nginx: розмір тіла запиту (узгодити з LOCAL_LISTING_PHOTO_MAX_SIZE_MB x кількість фото) і частота входу.
NGINX_MAX_BODY_SIZE=20M
NGINX_AUTH_RATE=20r/m
# IP, яким дозволено /admin/ (через кому, CIDR підтримується). Порожньо = відкрито (лише limit_req).
ADMIN_ALLOWED_IPS=
# true, якщо домен проксується Cloudflare (оранжева хмарка). Потрібен файл nginx/cloudflare-ips.conf:
# ./scripts/update-cloudflare-ips.sh. Разом з NUM_PROXIES=1 (nginx - єдина ланка перед Django).
CLOUDFLARE_PROXY=false
# Адреси балансувальника (через кому, CIDR підтримується) для TLS_MODE=external без Cloudflare: лише від
# них приймаються X-Forwarded-Proto і справжній IP клієнта (з X-Forwarded-For). Порожньо + external +
# CLOUDFLARE_PROXY=false = nginx не стартує. З Cloudflare не потрібен (діапазони з update-cloudflare-ips.sh).
TRUSTED_PROXY_IPS=

