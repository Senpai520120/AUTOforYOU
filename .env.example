# AUTOforYOU — environment variables template (UTF-8, no BOM)
# Copy to .env, fill in real values. Never commit .env to git.
# -----------------------------------------------------------------------

# --- Django core -------------------------------------------------------
# НА ПРОДІ — обов'язково! Генерація: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here
DEBUG=true
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# --- Database ----------------------------------------------------------
# DATABASE_URL=postgres://autoforyou:strongpassword@localhost:5432/autoforyou_db

# --- S3 media storage --------------------------------------------------
# S3_BUCKET_NAME=your-s3-bucket-name
# S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- LiqPay ------------------------------------------------------------
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key
LIQPAY_SANDBOX=true

# --- External APIs -----------------------------------------------------
OPENDATABOT_API_KEY=your_opendatabot_api_key
APIFY_TOKEN=your_apify_token

# --- Email -------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # вписати SMTP-провайдер на проді
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@autoforyou.ua

# --- Redis -------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# --- Telegram bot (all optional) --------------------------------------
# TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_BOT_USERNAME=your_bot_name_bot
# TELEGRAM_CHANNEL_ID=@your_channel
# TELEGRAM_B2B_CHANNEL_ID=@your_b2b_channel
# TELEGRAM_WEBHOOK_SECRET=your_random_secret_string
# SITE_URL=https://your-domain.com

# --- C2C: місцеві оголошення ------------------------------------------
# Максимум активних оголошень на акаунт (дефолт 10). Антиспам — C2C-промт 6.
# LOCAL_LISTING_MAX_ACTIVE=10

# --- Наступні C2C-промти (не активувати зараз!) ----------------------
# Apify — парсер аукціонів США (Copart/IAAI). Активація — окремий промт.
# APIFY_TOKEN=your_apify_token  ← вже є вище, нагадування для контексту
