# ─────────────────────────────────────────────────────────────────────────────
# AUTOforYOU — Docker Compose environment template
# Скопіюйте цей файл в .env і запустіть: docker compose up --build
# Паролі БД і Redis, SECRET_KEY і NEXT_PUBLIC_* треба задати вручну (задача 7.3): слабких дефолтів немає,
# `docker compose` зупиняється з поясненням, якщо щось порожнє.
# ЛОКАЛЬНИЙ (dev) шаблон (задача 7.7a, 12-C8): значення тут - для розробки на своєму комп'ютері. Dev-значення, яких НЕ можна
# переносити на сервер: DEBUG, ALLOWED_HOSTS/CORS/CSRF з localhost, TLS_MODE=off, тестові ключі Turnstile (завжди пропускають),
# ANTISPAM_MODE=soft, C2C_ENABLED=true. deploy.sh відсікає localhost у ALLOWED_HOSTS/SITE_URL і DEBUG=true на проді.
# Прод-шаблон зі значеннями за замовчуванням для відкриття сайту - .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Проект Compose и теги образов (задача 7.5) ───────────────────────────────
# Фиксирует имена томов (БД, media, сертификаты). Без него при клоне в другую папку создадутся
# новые пустые тома - тихая потеря данных. Не менять после первого запуска.
COMPOSE_PROJECT_NAME=autoforyou
# IMAGE_TAG ставит deploy.sh (git short sha) для отката на предыдущие образы; вручную не задавать.
# IMAGE_TAG=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=autoforyou
POSTGRES_USER=autoforyou
# Довгий випадковий пароль БЕЗ значення за замовчуванням (аудит C13). Тільки A-Za-z0-9 і -_ : він іде в DATABASE_URL.
POSTGRES_PASSWORD=
# Той самий пароль замість <POSTGRES_PASSWORD>:
DATABASE_URL=postgres://autoforyou:<POSTGRES_PASSWORD>@db:5432/autoforyou

# ─── Redis ────────────────────────────────────────────────────────────────────
# Пароль Redis (аудит C9, задача 7.3): довгий випадковий, тільки A-Za-z0-9 і -_ (іде в URL). Порожній = compose не стартує.
REDIS_PASSWORD=
# Той самий пароль замість <REDIS_PASSWORD>:
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# ─── Django ───────────────────────────────────────────────────────────────────
# Обов'язково: випадковий рядок не коротше 50 символів (задача 7.2). Заглушки з REPLACE,
# local-docker-dev, django-insecure або короткий ключ при DEBUG=false - помилка старту.
# Генерація: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# true = режим розробки: детальні сторінки помилок, без HTTPS-редиректів.
# ЗАВЖДИ false для будь-якого стенду, доступного ззовні. DEBUG=true з хостом, крім
# localhost/127.0.0.1/0.0.0.0/backend, в ALLOWED_HOSTS - помилка старту (задача 7.2).
DEBUG=false
# Обхід перевірки вище - лише для свідомого налагодження стенду. НІКОЛИ на проді.
# ALLOW_DEBUG_ON_PUBLIC_HOST=false
# Celery виконує задачі синхронно (без воркера). Раніше вмикалося від DEBUG.
# CELERY_EAGER=false

# Відкрити CORS для всіх origin. Раніше це вмикалося разом з DEBUG — тепер
# окремий прапорець. Вмикати тільки локально і тільки свідомо: у парі з
# CORS_ALLOW_CREDENTIALS=true це дозволяє будь-якому сайту ходити в API
# від імені залогіненого користувача.
CORS_ALLOW_ALL_ORIGINS=false

# Редирект HTTP -> HTTPS силами Django визначається TLS_MODE (блок HTTPS нижче).
# Явне SECURE_SSL_REDIRECT=false/true важливіше за режим; зазвичай не задається.
# SECURE_SSL_REDIRECT=

ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Origin, з яких приймаються POST/PUT/PATCH/DELETE з cookie-сесією (CSRF).
CSRF_TRUSTED_ORIGINS=http://localhost

# ─── JWT у httpOnly-cookie (задача 1.3) ───────────────────────────────────────
# Secure: браузер приймає такі cookie лише по HTTPS (і на http://localhost).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
# Порожньо = cookie лише для поточного хоста.
AUTH_COOKIE_DOMAIN=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ─── Frontend URLs ────────────────────────────────────────────────────────────
# URL, який браузер використовує для API-запитів (через nginx на порту 80)
NEXT_PUBLIC_API_URL=http://localhost

# URL сайту для SEO (sitemap, Open Graph canonical)
# Хости фото для next/image (через кому, лише https): домен сховища (S3_CUSTOM_DOMAIN).
# Якщо фото лотів не переносяться (LOT_PHOTO_ALLOWED_HOSTS порожній), сюди ж - конкретні CDN аукціонів.
# NEXT_PUBLIC_IMAGE_HOSTS=
NEXT_PUBLIC_SITE_URL=http://localhost

# INTERNAL_API_URL встановлюється автоматично в docker-compose.yml (http://backend:8000)
# Не потрібно вказувати тут.

# ─── LiqPay (платіжний шлюз) ─────────────────────────────────────────────────
# Sandbox=true → тестові платежі (не реальні кошти). Для тестування — залиш порожнім.
LIQPAY_SANDBOX=true
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Режими провайдерів (задача 3.1): auto | real | demo | off. auto: ключ є -> real, інакше off.
# LiqPay: auto | sandbox (тестові ключі) | real (бойовий) | off. Без ключів оплата відповідає 503.
LIQPAY_MODE=auto

# ─── Telegram Bot (необов'язково) ─────────────────────────────────────────────
# Без TELEGRAM_BOT_TOKEN бот не запускається, але сайт і API працюють нормально.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_B2B_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
# polling (за замовчуванням) або webhook (потрібні HTTPS, SITE_URL=https://... і секрет вище)
TELEGRAM_UPDATES_MODE=polling
TELEGRAM_BROKER_CHAT_ID=
# Telegram: auto | real | demo (повідомлення йдуть в Outbox) | off
TELEGRAM_MODE=auto
LEAD_JOURNAL_CHAT_ID=
SITE_URL=http://localhost

# ─── Email ────────────────────────────────────────────────────────────────────
# console — виводить листи у термінал замість відправки (зручно для dev)
# Для продакшн: вписати SMTP-провайдер (замінити рядок EMAIL_BACKEND нижче)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # вписати SMTP-провайдер на проді
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Порожньо = пошта «не налаштовано». На проді - адреса на вашому домені.
DEFAULT_FROM_EMAIL=
# Таймаут SMTP, секунди; скільки демо-відправок (Outbox) зберігати
# EMAIL_TIMEOUT=10
# DEMO_OUTBOX_KEEP=200
# auto: SMTP-бекенд + EMAIL_HOST + DEFAULT_FROM_EMAIL -> real, інакше «не налаштовано» (скидання пароля покаже 503).
# Для локальної перевірки без SMTP: EMAIL_MODE=demo (листи йдуть у консоль і в Outbox).
EMAIL_MODE=auto

# ─── Зовнішні API (необов'язково) ────────────────────────────────────────────
OPENDATABOT_API_KEY=
APIFY_TOKEN=
NBU_MODE=auto
# NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange
# EXCHANGE_RATE_MAX_AGE_DAYS=3
VIN_DECODE_MODE=auto
# VIN-звіт і Opendatabot заморожені (3.2a): off, поки VIN_REPORTS_ENABLED=false
VIN_REPORT_MODE=off
OPENDATABOT_MODE=off
LOTS_MODE=auto
# INTEGRATIONS_HTTP_TIMEOUT=10

# ─── S3 / Cloudflare R2 (необов'язково) ──────────────────────────────────────
# Без цих змінних медіафайли зберігаються локально в Docker volume (media).
# Основний варіант - Cloudflare R2 (ПЕРЕВІРИТИ актуальні умови в документації R2):
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Публічний домен бакета (CDN / custom domain R2): посилання на фото без підпису.
# Той самий хост додати в NEXT_PUBLIC_IMAGE_HOSTS. Без нього - підписані посилання.
# S3_CUSTOM_DOMAIN=media.yourdomain.com
# Окремий bucket БЕЗ публічного домену для приватних фото трекінгу (обов'язково разом із S3_CUSTOM_DOMAIN)
# PRIVATE_S3_BUCKET_NAME=
# Запасний варіант - AWS S3: без S3_ENDPOINT_URL, S3_REGION=eu-central-1.

# ─── Логи (задача 7.2) ───────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# Розмір і кількість файлів логу кожного контейнера (json-file).
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5
# Строк зберігання логів з IP, днів (рішення власника: 90).
# LOG_RETENTION_DAYS=90
# Swagger/Redoc і схема API для всіх (за замовчуванням - лише admin-роль).
# API_DOCS_PUBLIC=false

# ─── Nginx ────────────────────────────────────────────────────────────────────
# Порт, на якому nginx слухає на хості (дефолт 80 → http://localhost)
NGINX_PORT=80

# ─── Gunicorn ─────────────────────────────────────────────────────────────────
# Розраховано на сервер 4 ГБ; більше воркерів - лише після виміру `docker stats` (задача 7.3).
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
CELERY_CONCURRENCY=2

# ─── E2E (Playwright) ─────────────────────────────────────────────────────────
# ТІЛЬКИ для тестового стека / CI. На проді НЕ задавати.
# E2E_SEED_ALLOWED=true
# E2E_PASSWORD=

# Защита входа от перебора (задача 1.5)
NUM_PROXIES=1
# THROTTLE_LOGIN_RATE=10/min
# THROTTLE_REGISTER_RATE=5/hour
# THROTTLE_REFRESH_RATE=30/min
# Заявка брокеру (задача 2.1b): лимит на IP или пользователя
# THROTTLE_LEAD_RATE=5/hour
# THROTTLE_LEAD_EXPORT_RATE=10/hour
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15

# Подтверждение email и антибот (задача 1.6)
# turnstile | honeypot | off (off - только DEBUG=True). Honeypot работает всегда.
CAPTCHA_PROVIDER=turnstile
# ТОЛЬКО dev: всегда пропускают; на проде заменить. Публичные ТЕСТОВЫЕ ключи Cloudflare (не секреты). На проде заменить
# ключами из Cloudflare Dashboard -> Turnstile -> Add site. Без секрета работает только honeypot.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Порожній секрет = лише honeypot (так працює і прод, поки не заведено акаунт Cloudflare).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Вход: капча после N неудачных попыток (счётчик задачи 1.5); CAPTCHA_ON_LOGIN=true - всегда.
# CAPTCHA_LOGIN_AFTER_FAILURES=3
# CAPTCHA_ON_LOGIN=false
# CAPTCHA_MIN_FILL_SECONDS=3
# Ограничения до подтверждения email: объявления, сообщения, заявка дилера.
# EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_VERIFY_TTL_HOURS=48
# THROTTLE_VERIFY_RESEND_RATE=3/hour

# --- Мониторинг ошибок (задача 7.6): sentry.io или GlitchTip, пусто - выключен ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# Отчёты об ошибках фронтенда на IP
# THROTTLE_CLIENT_ERRORS_RATE=20/hour

# --- Celery: повторы и журнал упавших задач (задача 8.9) ---
# RESILIENT_TASK_MAX_RETRIES=3
# true: задача подтверждается после выполнения (при падении воркера не теряется, возможен повтор)
# RESILIENT_TASK_ACKS_LATE=true
# FAILED_TASK_RETENTION_DAYS=90
# FAILED_TASK_ARG_MAX_LEN=64

# --- Модули (задача 2.8): заморожены до разморозки задач 2.9, 2.10, 2.11, 3.3 ---
# Источник правды - только .env (в админке не редактируется); после смены нужен перезапуск backend.
# Держать false, как на проде. true любого флага при DEBUG=False - предупреждение launch_check.
LOTS_ENABLED=false
# Платні VIN-звіти (carVertical) і реєстри (Opendatabot): заморожені, тримати false
VIN_REPORTS_ENABLED=false
# Партнерське посилання carVertical (https://..., видає партнерська програма). Порожньо = посилання на сайті немає.
CARVERTICAL_PARTNER_URL=
B2B_ENABLED=false
DEALERS_ENABLED=false
SHIPMENTS_ENABLED=false
# Legacy cars (/api/calculate/, /api/list/), решение владельца Q7: оставить false
LEGACY_CARS_API_ENABLED=false

# --- Розділ «Оголошення по Україні» (C2C) і платежі (задача 6.7) ---
# Читається лише через core/c2c.py; після зміни перезапустити backend, celery worker і beat. Фронт перезбирати не треба.
# C2C_ENABLED: розділ видно. false = 404 на всіх C2C-маршрутах, фронт показує «Скоро».
# Для dev - true (розділ видно). У проді на запуску - false, див. .env.example.
C2C_ENABLED=true
# C2C_PUBLIC_POSTING_ENABLED: подача відкрита всім. false = «засів»: оголошення вносить staff через адмінку.
C2C_PUBLIC_POSTING_ENABLED=false
# PAYMENTS_ENABLED: створення оплат (просування, checkout). false = закрито. Callback LiqPay працює завжди (підпис обов'язкова).
PAYMENTS_ENABLED=false

# ─── HTTPS, HSTS, CSP (задача 7.1) ─────────────────────────────────────────────
# Домен сайту (без http/https). Для локальної розробки - localhost.
DOMAIN=localhost
# true = nginx приймає і www.DOMAIN (потрібні DNS-записи для обох імен).
DOMAIN_WWW=false
# Режим TLS: off (лише :80, розробка/CI), selfsigned (:443 із самопідписаним сертифікатом, тестовий стенд),
# letsencrypt (:443 + certbot; перший сертифікат: ./scripts/init-letsencrypt.sh), external (TLS знімає
# зовнішній балансувальник/Cloudflare; балансувальник ОБОВ'ЯЗКОВО ставить X-Forwarded-Proto).
# external БЕЗ Cloudflare вимагає TRUSTED_PROXY_IPS (нижче), інакше nginx не стартує.
# Порожній TLS_MODE у Django = колишня поведінка: SSL-редирект і HSTS увімкнені (для старих .env).
# Django і nginx беруть режим з цієї змінної. У режимах selfsigned/letsencrypt/external редирект робить nginx або
# балансувальник, Django не редиректить (SSR Next ходить у backend по http). Явний SECURE_SSL_REDIRECT важливіший.
# Порожній TLS_MODE у Django лишає колишню поведінку (редирект і HSTS), у nginx - off.
TLS_MODE=off
# Email для сповіщень Let's Encrypt про закінчення сертифіката; staging=true - пробний запуск без лімітів.
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=false
# HSTS віддається лише по https. preload майже незворотний: вмикати, лише коли ВСІ піддомени назавжди на https.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# true = політика CSP віддається як Content-Security-Policy-Report-Only (перший тиждень на проді).
CSP_REPORT_ONLY=false
# Додаткові джерела CSP: через пробіл, лише https://host[:port] (без * і без голого https:). Домени беріть з
# документації провайдерів: S3/R2, аналітика. Для CAPTCHA_PROVIDER=turnstile домен challenges.cloudflare.com
# додається в script-src і frame-src автоматично.
CSP_SCRIPT_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=
# Ліміти nginx: розмір тіла запиту (узгодити з LOCAL_LISTING_PHOTO_MAX_SIZE_MB x кількість фото) і частота входу.
NGINX_MAX_BODY_SIZE=20M
NGINX_AUTH_RATE=20r/m
# IP, яким дозволено /admin/ (через кому, CIDR підтримується). Порожньо = відкрито (лише limit_req).
ADMIN_ALLOWED_IPS=
# true, якщо домен проксується Cloudflare (оранжева хмарка). Потрібен файл nginx/cloudflare-ips.conf:
# ./scripts/update-cloudflare-ips.sh. Разом з NUM_PROXIES=1 (nginx - єдина ланка перед Django).
CLOUDFLARE_PROXY=false
# Адреси балансувальника (через кому, CIDR підтримується) для TLS_MODE=external без Cloudflare: лише від
# них приймаються X-Forwarded-Proto і справжній IP клієнта (з X-Forwarded-For). Порожньо + external +
# CLOUDFLARE_PROXY=false = nginx не стартує. З Cloudflare не потрібен (діапазони з update-cloudflare-ips.sh).
TRUSTED_PROXY_IPS=


# ─── Резервные копии Postgres (задача 7.4) ───────────────────────────────────
# Бэкап содержит ПДн: каталог не в git, права 600/700. Ручной запуск: ./scripts/backup.sh --now
# BACKUP_DIR=./backups
# BACKUP_TIME=03:30
# BACKUP_TZ=Europe/Kyiv
# Ротація копій (не строк зберігання ПДн): щоденних / недільних / за перше число місяця.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=3
# Копія поза сервером (рекомендовано). Основний варіант - Cloudflare R2 (ПЕРЕВІРИТИ ліміти й ціни).
# Окремий bucket лише для бекапів і окремий ключ. Без BACKUP_ENCRYPTION_PASSPHRASE відправка не виконується.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=autoforyou/
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Пароль шифрування (gpg AES256). ЗБЕРЕГТИ В МЕНЕДЖЕРІ ПАРОЛІВ ПОЗА СЕРВЕРОМ: без нього копії з хмари не розшифрувати.
# BACKUP_ENCRYPTION_PASSPHRASE=


# ═════════════════════════════════════════════════════════════════════════════
# Додатково (задача 7.7a): змінні, які читає код, але які раніше не були описані (12-C1).
# Тест core/tests_env_templates.py падає, якщо в коді з'являється змінна, якої немає в цьому файлі.
# ═════════════════════════════════════════════════════════════════════════════

# --- Антиспам і ліміти запитів ---------------------------------------------
# off - вимкнено | soft - лише позначати | hard - блокувати створення оголошень і відправку повідомлень.
# Локальний стек: soft (лише позначати). У проді - hard (див. .env.example).
ANTISPAM_MODE=soft
# Загальні ліміти DRF на IP (гість) і на користувача, дорогі зовнішні виклики (Opendatabot, NHTSA)
# THROTTLE_ANON_RATE=60/hour
# THROTTLE_USER_RATE=300/hour
# THROTTLE_EXPENSIVE_RATE=10/hour
# Повідомлення між користувачами і запити контакту продавця
# THROTTLE_MESSAGES_RATE=30/hour
# THROTTLE_CONTACT_RATE=20/hour
# Одноразовий form_token капчі (honeypot): строк життя, секунди
# CAPTCHA_FORM_TOKEN_MAX_AGE=3600

# --- Аукціонні збори і рейтинг продавця --------------------------------------
# Тип учасника аукціону за замовчуванням у калькуляторі (значення з довідника тарифів): broker | dealer | ...
# AUCTION_DEFAULT_MEMBER_TYPE=broker
# Скільки підтверджених угод потрібно для бейджа «Перевірений продавець»
# SELLER_BADGE_THRESHOLD=3

# --- C2C: оголошення (доповнення) -------------------------------------------
# Скільки днів оголошення активне до автоматичного закінчення строку; максимум фото на оголошення
# LOCAL_LISTING_EXPIRY_DAYS=30
# LOCAL_LISTING_MAX_PHOTOS=15
# Поріг «засіву»: мінімум активних оголошень у розділі, нижче якого launch_check попереджає (якщо C2C_ENABLED=true).
# Цифру встановлює власник за рішенням про запуск розділу; порожньо = перевірка пропускається.
# C2C_SEED_THRESHOLD=

# --- Telegram (доповнення) ---------------------------------------------------
# Скільки секунд пам'ятати update_id для відсіву повторів webhook
# TELEGRAM_UPDATE_DEDUP_TTL=86400

# --- Сховище медіа (доповнення) ----------------------------------------------
# Застаріла назва S3_CUSTOM_DOMAIN (читається, якщо S3_CUSTOM_DOMAIN порожній). Нові інсталяції - S3_CUSTOM_DOMAIN.
# AWS_S3_CUSTOM_DOMAIN=

# --- Лише розробка -----------------------------------------------------------
# Файл dev-ключа Django при DEBUG=true без SECRET_KEY. НА ПРОДІ НЕ ЗАДАВАТИ (там SECRET_KEY обов'язковий).
# DEV_SECRET_KEY_FILE=

# --- Compose: ресурси сервера (задача 7.3) -------------------------------------
# Ліміти пам'яті контейнерів. Розраховано на сервер 4 ГБ (CX23); змінювати лише після виміру
# ./scripts/check-memory.sh під навантаженням (ПЕРЕВІРИТИ на цільовому сервері).
# MEM_LIMIT_DB=768m
# MEM_LIMIT_REDIS=192m
# MEM_LIMIT_BACKEND=640m
# MEM_LIMIT_FRONTEND=512m
# MEM_LIMIT_BOT=256m
# MEM_LIMIT_CELERY_WORKER=512m
# MEM_LIMIT_CELERY_BEAT=256m
# MEM_LIMIT_NGINX=128m
# MEM_LIMIT_BACKUP=256m
# MEM_LIMIT_VOLUME_INIT=64m
# Перегляд памяті: scripts/check-memory.sh завершується помилкою, якщо контейнер займає більше цього відсотка
# від свого mem_limit. 85 - стартове значення (ПРОВЕРИТЬ по замірах під навантаженням).
# MEM_ALERT_PERCENT=85
# Postgres: буфери і максимум з'єднань (узгоджувати з MEM_LIMIT_DB), Redis: maxmemory нижче MEM_LIMIT_REDIS
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_MAX_CONNECTIONS=50
# REDIS_MAXMEMORY=128mb
# Стеля пам'яті Node.js (heap) під MEM_LIMIT_FRONTEND
# FRONTEND_NODE_OPTIONS=--max-old-space-size=384
# Порт HTTPS на хості (TLS_MODE=selfsigned/letsencrypt)
# NGINX_HTTPS_PORT=443

# --- Резервні копії (доповнення до блоку 7.4) ----------------------------------
# Зазвичай не змінюються. Копія поза сервером - Cloudflare R2 (окремий bucket і ключ лише для бекапів).
# BACKUP_ON_START=false

# --- Решта змінних, які читає код (задача 7.7a) ----------------------------------
# Сторінки моделей /prigon: кеш запитів (секунди) читає Next у runtime, див. frontend/.env.example.
# Імена cookie сесії (за замовчуванням access / refresh)
# AUTH_COOKIE_ACCESS_NAME=access
# AUTH_COOKIE_REFRESH_NAME=refresh
# Скільки днів зберігати анонімні розрахунки калькулятора
# ANON_CALCULATION_TTL_DAYS=30
# Запасний email брокера для заявок (основний - в адмінці), через кому/рядок
# BROKER_NOTIFY_EMAIL=
# Партнерський ключ API carVertical (модуль VIN_REPORTS_ENABLED заморожено)
# CARVERTICAL_API_KEY=
# Аналітика (порожньо = вимкнено): GA4 Measurement ID (G-XXXXXXXXXX) і токен Cloudflare Web Analytics
GA4_MEASUREMENT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
# Заявки брокеру: як часто досилати недоставлені (хвилини) і скільки спроб до попередження
# LEAD_NOTIFY_RETRY_MINUTES=10
# LEAD_NOTIFY_MAX_ATTEMPTS=5
# C2C: максимум активних оголошень на акаунт і розмір фото (порожньо = загальний UPLOAD_IMAGE_MAX_SIZE_MB)
# LOCAL_LISTING_MAX_ACTIVE=10
# LOCAL_LISTING_PHOTO_MAX_SIZE_MB=
# Хости CDN, звідки можна переносити фото лотів (порожньо = перенос вимкнено, режим фото "off")
# LOT_PHOTO_ALLOWED_HOSTS=
# Строк дії посилання скидання пароля, секунди
# PASSWORD_RESET_TIMEOUT=3600
# Приватні файли (фото трекінгу): каталог, відключення через nginx (X-Accel) і строк підписаного посилання S3
# PRIVATE_MEDIA_ROOT=
# PRIVATE_MEDIA_USE_X_ACCEL=false
# PRIVATE_MEDIA_URL_EXPIRE=300
# Ліміти запитів (повний перелік і значення за замовчуванням - .env.example і docs/LAUNCH_CHECKLIST.md)
# THROTTLE_CALCULATOR_RATE=30/hour
# THROTTLE_DATA_EXPORT_RATE=5/day
# THROTTLE_METRICS_EVENT_RATE=60/min
# THROTTLE_PASSWORD_RESET_RATE=5/hour
# THROTTLE_TELEGRAM_LINK_RATE=10/hour
# THROTTLE_UPLOADS_RATE=30/hour
# Безпечна загрузка фото (1.10): розмір МБ, максимум пікселів, формати, якість JPEG
# UPLOAD_IMAGE_MAX_SIZE_MB=8
# UPLOAD_IMAGE_MAX_PIXELS=25000000
# UPLOAD_IMAGE_ALLOWED_FORMATS=JPEG,PNG,WEBP
# UPLOAD_IMAGE_JPEG_QUALITY=85
# Адреса, з якої Next (SSR) читає /media/ для OG-картинок (nginx у docker-мережі). Змінювати не потрібно.
# INTERNAL_MEDIA_URL=http://nginx
