# ─────────────────────────────────────────────────────────────────────────────
# AUTOforYOU — Docker Compose environment template
# Скопіюйте цей файл в .env і запустіть: docker compose up --build
# Дефолти дозволяють запустити сайт локально БЕЗ ручного редагування.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=autoforyou
POSTGRES_USER=autoforyou
POSTGRES_PASSWORD=autoforyou_dev_pass
DATABASE_URL=postgres://autoforyou:autoforyou_dev_pass@db:5432/autoforyou

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Django ───────────────────────────────────────────────────────────────────
# Обов'язково: випадковий рядок не коротше 50 символів (задача 7.2). Заглушки з REPLACE,
# local-docker-dev, django-insecure або короткий ключ при DEBUG=false - помилка старту.
# Генерація: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# true = режим розробки: детальні сторінки помилок, без HTTPS-редиректів.
# ЗАВЖДИ false для будь-якого стенду, доступного ззовні. DEBUG=true з хостом, крім
# localhost/127.0.0.1/0.0.0.0/backend, в ALLOWED_HOSTS - помилка старту (задача 7.2).
DEBUG=false
# Обхід перевірки вище - лише для свідомого налагодження стенду. НІКОЛИ на проді.
# ALLOW_DEBUG_ON_PUBLIC_HOST=false
# Celery виконує задачі синхронно (без воркера). Раніше вмикалося від DEBUG.
# CELERY_EAGER=false

# Відкрити CORS для всіх origin. Раніше це вмикалося разом з DEBUG — тепер
# окремий прапорець. Вмикати тільки локально і тільки свідомо: у парі з
# CORS_ALLOW_CREDENTIALS=true це дозволяє будь-якому сайту ходити в API
# від імені залогіненого користувача.
CORS_ALLOW_ALL_ORIGINS=false

# Редирект HTTP -> HTTPS силами Django. За замовчуванням увімкнено при
# DEBUG=false. Вимикати лише там, де TLS немає взагалі (CI, локальний прогон
# E2E по HTTP) або де редирект вже робить балансувальник.
SECURE_SSL_REDIRECT=true

ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Origin, з яких приймаються POST/PUT/PATCH/DELETE з cookie-сесією (CSRF).
CSRF_TRUSTED_ORIGINS=http://localhost

# ─── JWT у httpOnly-cookie (задача 1.3) ───────────────────────────────────────
# Secure: браузер приймає такі cookie лише по HTTPS (і на http://localhost).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
# Порожньо = cookie лише для поточного хоста.
AUTH_COOKIE_DOMAIN=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ─── Frontend URLs ────────────────────────────────────────────────────────────
# URL, який браузер використовує для API-запитів (через nginx на порту 80)
NEXT_PUBLIC_API_URL=http://localhost

# URL сайту для SEO (sitemap, Open Graph canonical)
# Хости фото для next/image (через кому, лише https): домен сховища (S3_CUSTOM_DOMAIN).
# Якщо фото лотів не переносяться (LOT_PHOTO_ALLOWED_HOSTS порожній), сюди ж - конкретні CDN аукціонів.
# NEXT_PUBLIC_IMAGE_HOSTS=
NEXT_PUBLIC_SITE_URL=http://localhost

# INTERNAL_API_URL встановлюється автоматично в docker-compose.yml (http://backend:8000)
# Не потрібно вказувати тут.

# ─── LiqPay (платіжний шлюз) ─────────────────────────────────────────────────
# Sandbox=true → тестові платежі (не реальні кошти). Для тестування — залиш порожнім.
LIQPAY_SANDBOX=true
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Режими провайдерів (задача 3.1): auto | real | demo | off. auto: ключ є -> real, інакше off.
LIQPAY_MODE=auto

# ─── Telegram Bot (необов'язково) ─────────────────────────────────────────────
# Без TELEGRAM_BOT_TOKEN бот не запускається, але сайт і API працюють нормально.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_B2B_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BROKER_CHAT_ID=
TELEGRAM_MODE=auto
LEAD_JOURNAL_CHAT_ID=
SITE_URL=http://localhost

# ─── Email ────────────────────────────────────────────────────────────────────
# console — виводить листи у термінал замість відправки (зручно для dev)
# Для продакшн: вписати SMTP-провайдер (замінити рядок EMAIL_BACKEND нижче)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # вписати SMTP-провайдер на проді
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Порожньо = пошта «не налаштовано». На проді - адреса на вашому домені.
DEFAULT_FROM_EMAIL=
# Таймаут SMTP, секунди; скільки демо-відправок (Outbox) зберігати
# EMAIL_TIMEOUT=10
# DEMO_OUTBOX_KEEP=200
# auto: SMTP-бекенд + EMAIL_HOST + DEFAULT_FROM_EMAIL -> real, інакше «не налаштовано» (скидання пароля покаже 503).
# Для локальної перевірки без SMTP: EMAIL_MODE=demo (листи йдуть у консоль і в Outbox).
EMAIL_MODE=auto

# ─── Зовнішні API (необов'язково) ────────────────────────────────────────────
OPENDATABOT_API_KEY=
APIFY_TOKEN=
NBU_MODE=auto
# NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange
# EXCHANGE_RATE_MAX_AGE_DAYS=3
VIN_DECODE_MODE=auto
# VIN-звіт і Opendatabot заморожені (3.2a): off, поки VIN_REPORTS_ENABLED=false
VIN_REPORT_MODE=off
OPENDATABOT_MODE=off
LOTS_MODE=auto
# INTEGRATIONS_HTTP_TIMEOUT=10

# ─── S3 / Cloudflare R2 (необов'язково) ──────────────────────────────────────
# Без цих змінних медіафайли зберігаються локально в Docker volume (media).
# Основний варіант - Cloudflare R2 (ПЕРЕВІРИТИ актуальні умови в документації R2):
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Публічний домен бакета (CDN / custom domain R2): посилання на фото без підпису.
# Той самий хост додати в NEXT_PUBLIC_IMAGE_HOSTS. Без нього - підписані посилання.
# S3_CUSTOM_DOMAIN=media.yourdomain.com
# Окремий bucket БЕЗ публічного домену для приватних фото трекінгу (обов'язково разом із S3_CUSTOM_DOMAIN)
# PRIVATE_S3_BUCKET_NAME=
# Запасний варіант - AWS S3: без S3_ENDPOINT_URL, S3_REGION=eu-central-1.

# ─── Логи (задача 7.2) ───────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# Розмір і кількість файлів логу кожного контейнера (json-file).
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5
# Строк зберігання логів з IP, днів (рішення власника: 90).
# LOG_RETENTION_DAYS=90
# Swagger/Redoc і схема API для всіх (за замовчуванням - лише admin-роль).
# API_DOCS_PUBLIC=false

# ─── Nginx ────────────────────────────────────────────────────────────────────
# Порт, на якому nginx слухає на хості (дефолт 80 → http://localhost)
NGINX_PORT=80

# ─── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3

# ─── E2E (Playwright) ─────────────────────────────────────────────────────────
# ТІЛЬКИ для тестового стека / CI. На проді НЕ задавати.
# E2E_SEED_ALLOWED=true
# E2E_PASSWORD=

# Защита входа от перебора (задача 1.5)
NUM_PROXIES=1
# THROTTLE_LOGIN_RATE=10/min
# THROTTLE_REGISTER_RATE=5/hour
# THROTTLE_REFRESH_RATE=30/min
# Заявка брокеру (задача 2.1b): лимит на IP или пользователя
# THROTTLE_LEAD_RATE=5/hour
# THROTTLE_LEAD_EXPORT_RATE=10/hour
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15

# Подтверждение email и антибот (задача 1.6)
# turnstile | honeypot | off (off - только DEBUG=True). Honeypot работает всегда.
CAPTCHA_PROVIDER=turnstile
# ТОЛЬКО dev: всегда пропускают; на проде заменить. Публичные ТЕСТОВЫЕ ключи Cloudflare (не секреты). На проде заменить
# ключами из Cloudflare Dashboard -> Turnstile -> Add site. Без секрета работает только honeypot.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Вход: капча после N неудачных попыток (счётчик задачи 1.5); CAPTCHA_ON_LOGIN=true - всегда.
# CAPTCHA_LOGIN_AFTER_FAILURES=3
# CAPTCHA_ON_LOGIN=false
# CAPTCHA_MIN_FILL_SECONDS=3
# Ограничения до подтверждения email: объявления, сообщения, заявка дилера.
# EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_VERIFY_TTL_HOURS=48
# THROTTLE_VERIFY_RESEND_RATE=3/hour

# --- Мониторинг ошибок (задача 7.6): sentry.io или GlitchTip, пусто - выключен ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# Отчёты об ошибках фронтенда на IP
# THROTTLE_CLIENT_ERRORS_RATE=20/hour

# --- Celery: повторы и журнал упавших задач (задача 8.9) ---
# RESILIENT_TASK_MAX_RETRIES=3
# true: задача подтверждается после выполнения (при падении воркера не теряется, возможен повтор)
# RESILIENT_TASK_ACKS_LATE=true
# FAILED_TASK_RETENTION_DAYS=90
# FAILED_TASK_ARG_MAX_LEN=64

# --- Модули (задача 2.8): заморожены до разморозки задач 2.9, 2.10, 2.11, 3.3 ---
# Источник правды - только .env (в админке не редактируется); после смены нужен перезапуск backend.
# Держать false, как на проде. true любого флага при DEBUG=False - предупреждение launch_check.
LOTS_ENABLED=false
# Платні VIN-звіти (carVertical) і реєстри (Opendatabot): заморожені, тримати false
VIN_REPORTS_ENABLED=false
# Партнерське посилання carVertical (https://..., видає партнерська програма). Порожньо = посилання на сайті немає.
CARVERTICAL_PARTNER_URL=
B2B_ENABLED=false
DEALERS_ENABLED=false
SHIPMENTS_ENABLED=false
# Legacy cars (/api/calculate/, /api/list/), решение владельца Q7: оставить false
LEGACY_CARS_API_ENABLED=false
