# Основной шаблон nginx (задача 7.1). Рендерится скриптом docker-entrypoint.d/15-afy-nginx-setup.sh
# (envsubst по белому списку переменных) в /etc/nginx/conf.d/default.conf. Ни домена, ни email здесь нет.
# Серверные блоки подключаются по TLS_MODE через generated/active-servers.conf.

server_tokens off;
proxy_headers_hash_bucket_size 128;
client_max_body_size ${NGINX_MAX_BODY_SIZE};

# Сжатие (12-Q12): статика сжимается на лету, gzip_static убран (предсжатых файлов нет).
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml;

# Вход/регистрация (12-S10): ${NGINX_AUTH_RATE} с IP. Грубая сетка поверх лимитов Django.
limit_req_zone $binary_remote_addr zone=auth:10m rate=${NGINX_AUTH_RATE};
# Логин админки: ключ только для /admin/login/, у остальных путей пустой ключ = без лимита.
map $uri $admin_login_key {
    ~^/admin/login/$  $binary_remote_addr;
    default           "";
}
limit_req_zone $admin_login_key zone=admin_login:10m rate=${NGINX_AUTH_RATE};

# Connection: upgrade только при наличии заголовка Upgrade (12-Q12).
map $http_upgrade $connection_upgrade {
    default  upgrade;
    ""       "";
}

# Referrer-Policy: значение апстрима (Next ставит no-referrer на /password-reset, задача 1.7)
# важнее общего; без значения - строгий вариант по умолчанию. Заголовок апстрима скрывается.
map $upstream_http_referrer_policy $referrer_policy_value {
    default  $upstream_http_referrer_policy;
    ""       "strict-origin-when-cross-origin";
}

# /media/ (задача 1.10, 12-S7): всё, что не картинка, отдаётся только как вложение,
# браузер не отрисует загруженный HTML/SVG на нашем домене.
map $uri $media_disposition {
    ~*\.(jpe?g|png|webp)$  "";
    default                 "attachment";
}

# Access-лог без ПДн (задача 7.2, 12-S8): путь без query ($uri, не $request_uri/$args),
# последний октет IPv4 (и хвост IPv6) обнулён. Считается после real_ip (Cloudflare), то есть
# анонимизируется IP клиента. Срок хранения логов с IP - LOG_RETENTION_DAYS (90).
map $remote_addr $remote_addr_anon {
    ~(?P<ip>\d+\.\d+\.\d+)\.\d+    $ip.0;
    ~(?P<ip>[^:]+:[^:]+:[^:]+):     $ip::;
    default                          0.0.0.0;
}
log_format main_anon '$remote_addr_anon - [$time_local] "$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent $request_time';
access_log /var/log/nginx/access.log main_anon;

upstream backend {
    server backend:8000;
}

upstream frontend {
    server frontend:3000;
}

# Сгенерировано скриптом: real_ip (Cloudflare), карты X-Forwarded-Proto и HSTS.
include /etc/nginx/generated/real-ip.conf;
include /etc/nginx/generated/proto-map.conf;
include /etc/nginx/generated/hsts-map.conf;

include /etc/nginx/generated/active-servers.conf;
